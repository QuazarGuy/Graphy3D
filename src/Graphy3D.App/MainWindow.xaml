<Window x:Class="Graphy3D.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Graphy3D" Height="600" Width="960"
        MinHeight="360" MinWidth="600" KeyDown="OnKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Graphy3D rendering spike" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Fixed surface: z = 0.15 * (x^2 - y^2), x/y in [-3, 3]. Expression entry is not implemented."
                       TextWrapping="Wrap" />
        </StackPanel>
        <Border x:Name="SceneBorder" Grid.Row="1" Background="#F1F5F9"
                ClipToBounds="True">
            <Viewport3D x:Name="SceneViewport" Focusable="True"
                        MouseDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove"
                        MouseUp="OnViewportMouseUp" MouseWheel="OnViewportMouseWheel"
                        LostMouseCapture="OnViewportLostMouseCapture">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="SceneCamera" UpDirection="0,0,1"
                                       FieldOfView="45" NearPlaneDistance="0.1"
                                       FarPlaneDistance="200" />
                </Viewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <AmbientLight Color="#808080" />
                            <DirectionalLight Color="White" Direction="-1,1,-2" />
                            <GeometryModel3D x:Name="SurfaceModel">
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="#2563EB" />
                                </GeometryModel3D.Material>
                                <GeometryModel3D.BackMaterial>
                                    <DiffuseMaterial Brush="#F97316" />
                                </GeometryModel3D.BackMaterial>
                            </GeometryModel3D>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </Viewport3D>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Left drag: orbit | Right drag: pan | Wheel or +/-: zoom | Arrows: orbit | R: reset"
                       TextWrapping="Wrap" />
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="ResetViewButton" Content="Reset view" Click="OnResetClick" Padding="12,4"
                        DockPanel.Dock="Right" />
                <TextBlock x:Name="SceneStatus" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
